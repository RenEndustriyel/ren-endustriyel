{
  "name": "ren-endustriyel-desktop",
  "productName": "Ren Endüstriyel",
  "version": "1.0.1",
  "description": "Ren Endüstriyel Ön Muhasebe — masaüstü uygulaması",
  "author": "Ren Endüstriyel",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.renendustriyel.muhasebe",
    "productName": "Ren Endüstriyel",
    "copyright": "© 2026 Ren Endüstriyel",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "preload.cjs", "preload-uygulama.cjs", "lisans-ortak.cjs", "lisans-acik-anahtar.cjs", "sayfalar/**", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Ren-Endustriyel-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ren Endüstriyel",
      "uninstallDisplayName": "Ren Endüstriyel Ön Muhasebe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/lisans-sozlesmesi.txt",
      "installerLanguages": ["tr_TR"],
      "language": "1055",
      "deleteAppDataOnUninstall": false
    }
  }
}
